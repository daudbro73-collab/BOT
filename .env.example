BOT_TOKEN=your_telegram_bot_token
# Optional: leave empty for public market data only
BINANCE_API_KEY=
BINANCE_API_SECRET=
# Public market data host (fallback if api.binance.com is blocked)
BINANCE_HOSTNAME=data-api.binance.vision

# Scalp scanner
SCAN_INTERVAL_SEC=30
TOP_VOLATILE=30
MIN_24H_CHANGE_PCT=5.0
MIN_QUOTE_VOLUME_USDT=5000000
MIN_SIGNAL_SCORE=70

# Only 1m + 5m
DEFAULT_TIMEFRAMES=1m,5m

# Tighter SL/TP for scalping (ATR multipliers)
ATR_SL=1.0
ATR_TP1=1.5
ATR_TP2=2.5
